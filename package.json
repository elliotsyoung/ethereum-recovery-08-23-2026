{
  "name": "ethereum-recovery-08-23-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Local-only Ethereum keystore password recovery dashboard and recovery engine.",
  "main": "server/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "RECOVERY_MODE=DEMO node server/index.js",
    "real": "RECOVERY_MODE=REAL node server/index.js",
    "dev": "RECOVERY_MODE=DEMO nodemon server/index.js --fresh",
    "config:init": "node server/configInit.js",
    "reveal": "node server/reveal.js",
    "test": "node scripts/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/elliotsyoung/ethereum-recovery-08-23-2026.git"
  },
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "server",
      "public"
    ],
    "ext": "js,html,css",
    "ignore": [
      "data/**",
      "wallet/**"
    ]
  }
}
